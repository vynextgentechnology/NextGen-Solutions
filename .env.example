# Company Target Email for receiving leads: vynextgentechnology@gmail.com
# To enable live automated email delivery via Gmail:
# 1. Enable 2-Step Verification on vynextgentechnology@gmail.com (or sending Gmail account)
# 2. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 3. Generate a 16-character App Password for "Mail" / "Website"
# 4. Paste your 16-character App Password below without spaces:

EMAIL_USER=vynextgentechnology@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password

# Port configuration (Defaults to 5000)
PORT=5000
